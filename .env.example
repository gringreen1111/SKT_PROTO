# 있으면 LLM 에이전트(ApiEngine), 없으면 자동으로 RuleEngine 으로 동작한다.
# 키 없이 클론해도 전체 플로우가 끝까지 동작한다 — 완료 기준 §10 첫 항목.
ANTHROPIC_API_KEY=

# 선택. 기본값 claude-opus-5
#
# 지연 시간 주의: §4.4 예산은 "아이 발화 종료 → 첫 음성 2초 이내",
# LLM 타임아웃 2.5초다. Opus 5 는 thinking 이 기본 on 이라 이 예산 안에
# 못 들어올 수 있고, 그러면 매번 조용히 RuleEngine 으로 폴백한다
# (아이 화면은 정상이지만 대사가 매번 같아진다).
# ?dev=1 패널에서 engine=rule 이 계속 뜨면 아래를 바꿔 본다.
ANTHROPIC_MODEL=claude-opus-5
# ANTHROPIC_MODEL=claude-haiku-4-5

# 선택. 기본 2500(ms). 타임아웃을 늘리면 LLM 성공률은 오르지만
# 아이가 기다리는 시간도 같이 늘어난다.
# LLM_TIMEOUT_MS=2500
